{
  "name": "digitalni-cjenik-nepar",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "prebuild": "node scripts/prepare-public-fixture.mjs",
    "postbuild": "node scripts/prerender.mjs && node scripts/verify-dist.mjs",
    "typecheck:app": "tsc -b --pretty false",
    "typecheck:functions": "tsc -p functions --pretty false",
    "typecheck:shared": "tsc -p shared --pretty false",
    "typecheck:workers": "tsc -p workers/monitor --pretty false",
    "typecheck": "npm run typecheck:app && npm run typecheck:functions && npm run typecheck:shared && npm run typecheck:workers",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "generate:share-assets": "node scripts/generate-share-assets.mjs",
    "indexnow": "node scripts/indexnow.mjs",
    "ci": "npm run typecheck && npm test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "qrcode": "^1.5.4",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.11",
    "@playwright/test": "^1.63.0"
  }
}
