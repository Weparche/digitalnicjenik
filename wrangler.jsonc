{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "digitalni-cjenik-nepar",
  "compatibility_date": "2026-09-17",
  "pages_build_output_dir": "dist",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "digitalni-cjenik-nepar",
      "database_id": "5fab5acf-0d2d-4355-895b-39da1f0462e1",
      "migrations_dir": "./migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "DRAFTS",
      "bucket_name": "digitalnicjenik-drafts"
    }
  ],
  "vars": {
    "DEMO_WRITE_TENANT": "nepar",
    "DEMO_PUBLIC_HOSTNAME": "digitalnicjenik.nepar.hr",
    "DEFAULT_PUBLICATION_TIMEZONE": "Europe/Zagreb",
    "CF_ACCOUNT_ID": "a0ec5e0ddb36f340bf00d1520dfa7f2b",
    "EMAIL_FROM": "publisher@nepar.hr",
    "EMAIL_TO": "nepar@nepar.hr",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAE81Y0hv6uzetB4O"
  },
  "env": {
    "preview": {
      "name": "digitalnicjenik-preview",
      "r2_buckets": [
        {
          "binding": "DRAFTS",
          "bucket_name": "digitalnicjenik-drafts"
        }
      ],
      "vars": {
        "DEMO_WRITE_TENANT": "nepar",
        "DEMO_PUBLIC_HOSTNAME": "digitalnicjenik.nepar.hr",
        "DEFAULT_PUBLICATION_TIMEZONE": "Europe/Zagreb",
        "CF_ACCOUNT_ID": "a0ec5e0ddb36f340bf00d1520dfa7f2b",
        "EMAIL_FROM": "publisher@nepar.hr",
        "EMAIL_TO": "nepar@nepar.hr",
        "TURNSTILE_SITE_KEY": "0x4AAAAAAE81Y0hv6uzetB4O"
      }
    },
    "production": {
      "name": "digitalnicjenik",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "digitalni-cjenik-nepar",
          "database_id": "5fab5acf-0d2d-4355-895b-39da1f0462e1",
          "migrations_dir": "./migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "DRAFTS",
          "bucket_name": "digitalnicjenik-drafts"
        }
      ],
      "vars": {
        "DEMO_WRITE_TENANT": "nepar",
        "DEMO_PUBLIC_HOSTNAME": "digitalnicjenik.nepar.hr",
        "DEFAULT_PUBLICATION_TIMEZONE": "Europe/Zagreb",
        "CF_ACCOUNT_ID": "a0ec5e0ddb36f340bf00d1520dfa7f2b",
        "EMAIL_FROM": "publisher@nepar.hr",
        "EMAIL_TO": "nepar@nepar.hr",
        "TURNSTILE_SITE_KEY": "0x4AAAAAAE81Y0hv6uzetB4O"
      }
    }
  }
}
